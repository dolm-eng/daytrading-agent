# Copie ce fichier en ".env" et remplis tes propres clés.
# Ce sont les clés de ton compte PAPER (argent fictif) Alpaca, pas les clés live.
# Obtiens-les gratuitement sur https://app.alpaca.markets apres inscription
# (bouton "Paper Trading" en haut a gauche du dashboard -> API Keys).
#
# CONSEILLE : cree un DEUXIEME compte paper dedie au day trading (Alpaca le
# permet depuis le menu des comptes paper) plutot que de reutiliser les cles
# de l'agent long terme. Sinon les deux bots partagent le meme argent, le
# meme coupe-circuit quotidien et le day trader ignore les symboles deja
# detenus par l'autre bot.

ALPACA_API_KEY=ta_cle_api_paper_ici
ALPACA_SECRET_KEY=ta_cle_secrete_paper_ici

# Ne jamais utiliser d'argent reel avant d'avoir valide la strategie
# en paper trading pendant plusieurs semaines et compris ses risques.

# --- Notification email (optionnel, laisse vide pour desactiver) ---
# Exemple avec Gmail : SMTP_USER = ton adresse Gmail complete,
# SMTP_PASSWORD = un "mot de passe d'application" (PAS ton mot de passe Gmail
# normal), a generer sur https://myaccount.google.com/apppasswords
# (necessite la validation en 2 etapes activee sur le compte Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=ton_mot_de_passe_application
EMAIL_TO=ton.email@gmail.com
